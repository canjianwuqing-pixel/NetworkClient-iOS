+func TestSetupOwnsExplicitClashAPISocketPath(t *testing.T) {
+	options := testOptions(t)
+	explicit := shortClashSocketPath(t)
+	options.ClashAPISocketPath = explicit
+	if err := Setup(options); err != nil {
+		t.Fatalf("Setup: %v", err)
+	}
+	if got := APIPath(); got != explicit {
+		t.Fatalf("APIPath() = %q, want explicit %q", got, explicit)
+	}
+	if err := startControlPlane(nil, APIPath()); err != nil {
+		t.Fatalf("startControlPlane explicit short path: %v", err)
+	}
+	stopClashAPI(APIPath())
+}
+
+func TestClashAPIRejectsOverlongExplicitUnixPath(t *testing.T) {
+	path := "/" + strings.Repeat("x", clashAPIMaxUnixPathBytes)
+	if got := len([]byte(path)); got != clashAPIMaxUnixPathBytes+1 {
+		t.Fatalf("test path is %d bytes, want %d", got, clashAPIMaxUnixPathBytes+1)
+	}
+	err := startControlPlane(nil, path)
+	if err == nil {
+		t.Fatal("startControlPlane accepted an overlong explicit path")
+	}
+	if !strings.Contains(err.Error(), "Darwin limit is 103") {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
