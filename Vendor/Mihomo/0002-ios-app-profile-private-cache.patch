+// bbolt's mode argument only applies when it creates a file. Tighten older
+// app-owned caches before opening them and refuse non-regular paths.
+func hardenExistingCacheFile(path string) error {
+	info, err := os.Lstat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return errors.New("cachefile: cache path is not a regular file")
+	}
+	if info.Mode().Perm()&0o077 != 0 {
+		return os.Chmod(path, fileMode)
+	}
+	return nil
+}
+
 // Cache return singleton of CacheFile
