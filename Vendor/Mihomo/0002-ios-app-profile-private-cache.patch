diff --git a/bind/clash/runtime_profile_ios_application_test.go b/bind/clash/runtime_profile_ios_application_test.go
new file mode 100644
index 0000000..cf8dc6a
--- /dev/null
+++ b/bind/clash/runtime_profile_ios_application_test.go
@@ -0,0 +1,17 @@
+package clash
+
+import "testing"
+
+func TestIOSApplicationHasNoPacketTunnelOrDNSRepair(t *testing.T) {
+	for _, underNE := range []bool{false, true} {
+		p := runtimePolicyFor(runtimeProfileIOSApplication, underNE)
+		if p.networkExtension || p.packetTunnel || p.requirePacketTunnelDNS ||
+			p.repairPacketTunnelDNS || p.stripLoopbackResolvers || p.bindsUnixControlSocket ||
+			p.trustedProcessMetadata || !p.useSystemDNS {
+			t.Fatalf("iOS application policy leaked tunnel behavior with underNE=%v: %+v", underNE, p)
+		}
+	}
+	if got, err := normalizeRuntimeProfile(RuntimeProfileIOSApplication); err != nil || got != runtimeProfileIOSApplication {
+		t.Fatalf("normalize iOS application = %v, %v", got, err)
+	}
+}
diff --git a/component/profile/cachefile/private_mode_test.go b/component/profile/cachefile/private_mode_test.go
new file mode 100644
index 0000000..cf6e8e8
--- /dev/null
+++ b/component/profile/cachefile/private_mode_test.go
@@ -0,0 +1,48 @@
+package cachefile
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPersistentCacheCreationModeIsPrivate(t *testing.T) {
+	if fileMode.Perm() != 0o600 {
+		t.Fatalf("cache.db creation mode = %04o, want 0600", fileMode.Perm())
+	}
+}
+
+func TestExistingCachePermissionsAreTightened(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "cache.db")
+	if err := os.WriteFile(path, []byte("old-cache"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(path, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := hardenExistingCacheFile(path); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o600 {
+		t.Fatalf("cache mode = %04o", info.Mode().Perm())
+	}
+}
+
+func TestCacheSymlinkIsRefused(t *testing.T) {
+	dir := t.TempDir()
+	target := filepath.Join(dir, "target")
+	link := filepath.Join(dir, "cache.db")
+	if err := os.WriteFile(target, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(target, link); err != nil {
+		t.Fatal(err)
+	}
+	if err := hardenExistingCacheFile(link); err == nil {
+		t.Fatal("symlink cache accepted")
+	}
+}
