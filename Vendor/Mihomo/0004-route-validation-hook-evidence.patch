+//go:build clash_internal
+
+package clash
+
+import (
+	"encoding/json"
+	"errors"
+	"net"
+	"testing"
+
+	"github.com/ProjectClash/Clash/component/dialer"
+)
+
+func hookSnapshot(t *testing.T) map[string]map[string]uint64 {
+	t.Helper()
+	var result map[string]map[string]uint64
+	if err := json.Unmarshal([]byte(SocketHookDiagnosticsJSON()), &result); err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+func TestInternalHookCountersComeFromActualHook(t *testing.T) {
+	previousHook, previousTransform := dialer.DefaultSocketHook, dialer.DefaultAddressTransform
+	previousIndex := publishedInterfaceIndex.Load()
+	t.Cleanup(func() {
+		dialer.DefaultSocketHook, dialer.DefaultAddressTransform = previousHook, previousTransform
+		publishedInterfaceIndex.Store(previousIndex)
+		noPathDialsLogged.Store(false)
+	})
+	packet, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer packet.Close()
+	raw, err := packet.(*net.UDPConn).SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	platform := &hookPlatform{enabled: true}
+	installSocketHook(platform)
+	publishedInterfaceIndex.Store(0)
+	before := hookSnapshot(t)
+	for _, test := range []struct{ network, address, kind string }{
+		{"tcp", "1.1.1.1:443", "tcp4"},
+		{"udp", "1.1.1.1:443", "udp4"},
+		{"tcp", "[2606:4700:4700::1111]:443", "tcp6"},
+		{"udp", "[2606:4700:4700::1111]:443", "udp6"},
+	} {
+		if err := dialer.DefaultSocketHook(test.network, test.address, raw); !errors.Is(err, ErrNoPhysicalPath) {
+			t.Fatalf("%s no-path hook = %v", test.kind, err)
+		}
+		if got := hookSnapshot(t)[test.kind]["noPhysicalPath"]; got != before[test.kind]["noPhysicalPath"]+1 {
+			t.Fatalf("%s hook count = %d", test.kind, got)
+		}
+	}
+	if platform.callCount != 0 {
+		t.Fatal("no-path requests reached platform binder")
+	}
+	platform.controlErr = errors.New("controlled bind failure")
+	publishedInterfaceIndex.Store(5)
+	before = hookSnapshot(t)
+	if err := dialer.DefaultSocketHook("udp", "1.1.1.1:443", raw); !errors.Is(err, platform.controlErr) {
+		t.Fatalf("bind error lost: %v", err)
+	}
+	if got := hookSnapshot(t)["udp4"]["platformBindFailure"]; got != before["udp4"]["platformBindFailure"]+1 {
+		t.Fatalf("platform error hook count = %d", got)
+	}
+	if got := SocketHookDiagnosticsJSON(); len(got) == 0 || len(got) > 2048 {
+		t.Fatal("unexpected diagnostics size")
+	}
+}
+
+func TestInternalNoPathProbeUsesRealDialer(t *testing.T) {
+	previousHook, previousTransform := dialer.DefaultSocketHook, dialer.DefaultAddressTransform
+	previousIndex := publishedInterfaceIndex.Load()
+	t.Cleanup(func() {
+		dialer.DefaultSocketHook, dialer.DefaultAddressTransform = previousHook, previousTransform
+		publishedInterfaceIndex.Store(previousIndex)
+		noPathDialsLogged.Store(false)
+	})
+	installSocketHook(&hookPlatform{enabled: true})
+	publishedInterfaceIndex.Store(0)
+	for _, test := range []struct {
+		network string
+		ipv6    bool
+		kind    string
+	}{
+		{"tcp", false, "tcp4"}, {"udp", false, "udp4"},
+		{"tcp", true, "tcp6"}, {"udp", true, "udp6"},
+	} {
+		before := hookSnapshot(t)[test.kind]["noPhysicalPath"]
+		result := ProbeNoPathDial(test.network, test.ipv6)
+		got := hookSnapshot(t)[test.kind]["noPhysicalPath"]
+		if result == "hook-refused" {
+			if got <= before {
+				t.Fatalf("%s reported a hook refusal without a hook count", test.kind)
+			}
+		} else if !test.ipv6 || result != "rejected-before-hook-or-other-error" || got != before {
+			t.Fatalf("%s unexpected probe result=%s count=%d", test.kind, result, got)
+		}
+	}
+}
