+//go:build clash_internal
+
+package clash
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/netip"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/ProjectClash/Clash/component/dialer"
+)
+
+type socketHookOutcome uint8
+
+const (
+	hookLocalBypass socketHookOutcome = iota
+	hookNoPath
+	hookControlFailure
+	hookBindFailure
+	hookBound
+	hookOutcomeCount
+)
+
+const (
+	hookTCP4 = iota
+	hookTCP6
+	hookUDP4
+	hookUDP6
+	hookUnknown
+	hookKindCount
+)
+
+var socketHookCounters [hookKindCount][hookOutcomeCount]atomic.Uint64
+
+var hookKindNames = [hookKindCount]string{"tcp4", "tcp6", "udp4", "udp6", "unknown"}
+var hookOutcomeNames = [hookOutcomeCount]string{
+	"localBypass", "noPhysicalPath", "rawControlFailure", "platformBindFailure", "bound",
+}
+
+func socketHookKind(network, address string) int {
+	var transport int
+	switch {
+	case strings.HasPrefix(strings.ToLower(network), "tcp"):
+		transport = hookTCP4
+	case strings.HasPrefix(strings.ToLower(network), "udp"):
+		transport = hookUDP4
+	default:
+		return hookUnknown
+	}
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		host = address
+	}
+	ip, err := netip.ParseAddr(host)
+	if err != nil {
+		return hookUnknown
+	}
+	if ip.Unmap().Is4() {
+		return transport
+	}
+	return transport + 1
+}
+
+func recordSocketHookOutcome(network, address string, outcome socketHookOutcome) {
+	socketHookCounters[socketHookKind(network, address)][outcome].Add(1)
+}
+
+// SocketHookDiagnosticsJSON is exported only by the isolated internal SDK.
+// It contains aggregate counters and no destination, credential or node data.
+// UDP includes QUIC; the hook cannot distinguish QUIC from other UDP sockets.
+func SocketHookDiagnosticsJSON() string {
+	result := make(map[string]map[string]uint64, hookKindCount)
+	for kind, name := range hookKindNames {
+		outcomes := make(map[string]uint64, hookOutcomeCount)
+		for outcome, label := range hookOutcomeNames {
+			outcomes[label] = socketHookCounters[kind][outcome].Load()
+		}
+		result[name] = outcomes
+	}
+	data, err := json.Marshal(result)
+	if err != nil {
+		return "{}"
+	}
+	return string(data)
+}
+
+// ProbeNoPathDial exercises the real SDK dialer-to-hook chain with a fixed
+// documentation address. It exists only in the isolated internal build.
+func ProbeNoPathDial(network string, ipv6 bool) string {
+	if network != "tcp" && network != "udp" {
+		return "invalid-test-kind"
+	}
+	if publishedInterfaceIndex.Load() != 0 {
+		return "physical-path-present"
+	}
+	address := "198.51.100.1:443"
+	if ipv6 {
+		address = "[2001:db8::1]:443"
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	connection, err := dialer.DialContext(ctx, network, address)
+	if connection != nil {
+		_ = connection.Close()
+		return "unexpected-connected"
+	}
+	if errors.Is(err, ErrNoPhysicalPath) {
+		return "hook-refused"
+	}
+	if err == nil {
+		return "unexpected-no-error"
+	}
+	return "rejected-before-hook-or-other-error"
+}
