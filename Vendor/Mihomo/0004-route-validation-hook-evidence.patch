+//go:build !clash_internal
+
+package clash
+
+type socketHookOutcome uint8
+
+const (
+	hookLocalBypass socketHookOutcome = iota
+	hookNoPath
+	hookControlFailure
+	hookBindFailure
+	hookBound
+)
+
+// The production SDK has no diagnostic state or exported fault interface.
+func recordSocketHookOutcome(_, _ string, _ socketHookOutcome) {}
