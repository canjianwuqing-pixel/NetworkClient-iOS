    "consent.modal.message" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Please read and agree to the Terms of Use and Privacy Notice first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先阅读并同意《使用条款与隐私说明》"}}}},
    "consent.modal.title" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Dear User"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尊敬的用户"}}}},
    "consent.section.account.body" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You may submit a permanent account deletion request from Profile. An administrator will process the request within 7 days. If this notice or relevant data practices change materially, a newer consent version may require your agreement again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"您可以在“我的”页面提交永久删除账户申请，管理员将在 7 日内处理。若本说明或相关数据处理发生重大变化，版本更新后可能需要您重新确认。"}}}},
    "consent.section.account.title" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Account Deletion & Policy Updates"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户删除与政策更新"}}}},
    "consent.section.privacy.body" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"To provide account and service features, the app processes necessary account, subscription, traffic, order, payment-status, device, and network information. Diagnostic logs are stored on this device and are shared only when you choose to export them or provide them for support."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为提供账户和服务功能，App 会处理必要的账户、订阅、流量、订单、支付状态、设备及网络信息。诊断日志保存在本机，仅在您主动导出或提供给客服时分享。"}}}},
    "consent.section.privacy.title" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy Policy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"隐私政策"}}}},
    "consent.section.terms.body" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the service lawfully and keep your account information secure. Service availability may vary due to network conditions, maintenance, or applicable requirements."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请依法使用服务并妥善保管账户信息。服务可用性可能因网络状况、维护或适用要求而变化。"}}}},
    "consent.section.terms.title" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Terms of Service"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务条款"}}}},
    "consent.section.vpn.body" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"When VPN is active, your selected VPN node and DNS or service infrastructure must technically process information needed to route and maintain the connection. The app uses subscription data, node configuration, and connection status to establish and manage that connection."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"VPN 启用期间，所选 VPN 节点及 DNS 或服务基础设施会在技术上处理路由和维持连接所必需的信息。App 使用订阅信息、节点配置和连接状态来建立及管理连接。"}}}},
    "consent.section.vpn.title" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"VPN Data Use"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"VPN 数据使用说明"}}}},
    "vpn.connect.unable.title" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to Start VPN"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法开始连接"}}}},
    "vpn.connect.unable.message" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The VPN connection could not be started. Select the node again and retry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法开始连接，请重新选择节点后重试。"}}}},
