    "consent.checkbox.statement" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"I have read and agree to the Terms of Use and Privacy Notice"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我已阅读并同意《使用条款与隐私说明》"}}}},
