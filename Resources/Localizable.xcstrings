    "vpn.preflight.selected_node_missing.message" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The previously selected node is no longer available or has changed. Please select another node."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"您之前选择的节点已不存在或配置已更新，请重新选择一个节点。"}}}},
